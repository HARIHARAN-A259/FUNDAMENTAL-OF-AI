# ── Environment variables for ColdGuard backend ──
# Copy this file to .env and fill in your values.

APP_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite (default). To switch to PostgreSQL replace with:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/coldguard
DATABASE_URL=sqlite:///./coldguard.db

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Optional: Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=coldguard@example.com
EMAIL_TO=

# Sensor ingestion API key (for ESP32 / MQTT)
SENSOR_API_KEY=change-me-sensor-key

# Cors origin for the React frontend
FRONTEND_ORIGIN=http://localhost:5173

